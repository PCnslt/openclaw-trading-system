{
  "name": "Daily Gainers Prediction (HF Models)",
  "nodes": [
    {
      "id": "cron-trigger",
      "name": "Daily 4 PM EST",
      "type": "n8n-nodes-base.cron",
      "position": [200, 300],
      "parameters": {
        "triggerTimes": {
          "item": [{"mode": "everyDay", "hour": 16, "minute": 0}]
        }
      }
    },
    {
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [200, 500],
      "parameters": {}
    },
    {
      "id": "http-request",
      "name": "Run Python Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "position": [500, 300],
      "parameters": {
        "url": "http://127.0.0.1:18888/run-prediction",
        "options": {},
        "method": "GET",
        "authentication": "none",
        "sendQuery": false,
        "sendBody": false,
        "sendHeaders": false
      }
    },
    {
      "id": "code-process",
      "name": "Parse Results",
      "type": "n8n-nodes-base.code",
      "position": [750, 300],
      "parameters": {
        "jsCode": "const data = $input.item.json;\nlet results = [];\nif (data && data.top_10) {\n  results = data.top_10.map(item => ({\n    json: {\n      rank: item.rank,\n      ticker: item.ticker,\n      predicted_return: item.predicted_return,\n      target_date: data.target_date,\n      base_date: data.base_date\n    }\n  }));\n} else if (data && data.predictions) {\n  results = data.predictions.map((item, i) => ({\n    json: {\n      rank: i + 1,\n      ticker: item.ticker || item.symbol,\n      predicted_return: item.return || item.confidence,\n      target_date: data.target_date || '',\n      base_date: data.base_date || ''\n    }\n  }));\n}\nreturn results.length ? results : [{json: {error: 'No predictions parsed', raw: JSON.stringify(data).substring(0,200)}}];"
      }
    },
    {
      "id": "log-to-vault",
      "name": "Log to Vault",
      "type": "n8n-nodes-base.writeFile",
      "position": [1000, 300],
      "parameters": {
        "fileName": "02_Projects/Top_Gainers_Predictor/prediction_{{ $now.format('YYYY-MM-DD') }}.json",
        "content": "={{ $json }}"
      }
    }
  ],
  "connections": {
    "Daily 4 PM EST": {"main": [[{"node": "Run Python Pipeline", "type": "main"}]]},
    "Manual Trigger": {"main": [[{"node": "Run Python Pipeline", "type": "main"}]]},
    "Run Python Pipeline": {"main": [[{"node": "Parse Results", "type": "main"}]]},
    "Parse Results": {"main": [[{"node": "Log to Vault", "type": "main"}]]}
  }
}
